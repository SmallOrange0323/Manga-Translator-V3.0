{
  "manifest_version": 3,
  "key": "",
  "name": "Manga Translator V3.1.11",
  "version": "3.1.11",
  "description": "Modernized Manga Translator with 2D Alternating Round-Robin Hybrid Speed Pipeline",
  "incognito": "split",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "contextMenus",
    "identity",
    "downloads",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "oauth2": {
    "client_id": "892014744898-61cck565ped868ht31jjqc8apsvpm6gf.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "wnacg_local_jquery",
        "enabled": true,
        "path": "rules/wnacg.json"
      }
    ]
  },
  "content_scripts": [
    {
      "js": ["src/content/main.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/jquery-1.10.2.min.js",
        "vendor/jquery-1.6.2.min.js",
        "vendor/jquery-ui-1.8.24.min.js"
      ],
      "matches": ["*://*.wnacg.com/*"]
    },
    {
      "resources": [
        "icon.svg",
        "icon16.png",
        "icon32.png",
        "icon48.png",
        "icon128.png",
        "src/mobile/index.html",
        "src/popup/index.html",
        "src/popup/main.js",
        "src/options/index.html",
        "src/reader/stream-reader.html",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "漫譯",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
